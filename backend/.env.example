# Supabase project (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# service_role secret key — server only, never expose to the browser
SUPABASE_SECRET_KEY=your-service-role-secret-key
# Google AI Studio key used for SAL (Gemini) and knowledge-base embeddings
GEMINI_API_KEY=your-gemini-api-key

# Frontend origin, used for CSRF origin checks and email-confirmation redirects
APP_ORIGIN=http://127.0.0.1:3107
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false
# disabled | test (test enables the sandbox payment provider)
PAYMENT_PROVIDER=disabled

# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Set GEMINI_FALLBACK_MODEL= to disable transient-error failover.
# EMBEDDING_MODEL=gemini-embedding-001
# CLINIC_TIMEZONE=Asia/Jerusalem
